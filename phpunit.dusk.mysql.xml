<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         defaultTestSuite="Browser"
>
    <testsuites>
        <testsuite name="Browser">
            <directory>tests/Browser</directory>
        </testsuite>
    </testsuites>
    <php>
        <!-- Wie phpunit.dusk.xml, aber SAFT auf MySQL: lädt .env.browser-mysql; Absicherung in DuskTestCase. -->
        <env name="APP_ENV" value="browser-mysql" force="true"/>
        <!-- Arbeiten (Fundament 2): Vorgaben festlegen, damit Werte zum Zuschauen in der .env die Tests nicht verändern -->
        <env name="WORK_DRIVER" value="auto"/>
        <env name="WORK_INLINE_BUDGET" value="10"/>
        <env name="WORK_BROWSER_BUDGET" value="15"/>
        <env name="WORK_SCHEDULER_BUDGET" value="50"/>
        <env name="WORK_QUEUE_BUDGET" value="50"/>
        <env name="APP_DATA_EXPORT_CHUNK" value="1000"/>
        <env name="APP_DATA_IMPORT_CHECK_ROWS" value="2000"/>
        <env name="APP_DATA_IMPORT_MAX_RECORD_ROWS" value="100000"/>
        <env name="REPORTS_SNAPSHOT_CHUNK" value="1000"/>
        <env name="REPORTS_SNAPSHOT_MAX_ROWS" value="1000000"/>
        <env name="DOCUMENTS_BATCH_MAX" value="0"/>
    </php>
</phpunit>
