APP_NAME="SAFT XT"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=Europe/Zurich
APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Datenbank: pgsql (PostgreSQL 16 oder neuer), mysql (MySQL 8.0.16 oder neuer) oder mariadb (MariaDB 10.11 oder neuer).
# PostgreSQL: Der Benutzer muss ein Schema anlegen dürfen (Eigentümer der Datenbank).
# MySQL/MariaDB: Der Benutzer braucht zusätzlich die Datenbank <DB>_app_data (Table-Designer).
DB_CONNECTION=pgsql

PGSQL_HOST=127.0.0.1
PGSQL_PORT=5432
PGSQL_DATABASE=SAFT2
PGSQL_USERNAME=saft
PGSQL_PASSWORD=
# require, wenn die Datenbank auf einem anderen Rechner liegt
DB_SSLMODE=prefer

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=SAFT2
MYSQL_USERNAME=saft
MYSQL_PASSWORD=

# Zweite Datenbank für die Tabellen des Table-Designers (MySQL/MariaDB; Vorgabe <datenbank>_app_data). Eigener Name,
# Server und Benutzer z. B. bei Hostern mit einem Benutzer je Datenbank (Strato); leer = wie die Hauptdatenbank.
# APP_DATA_SCHEMA=
# DB_APP_DATA_HOST=
# DB_APP_DATA_PORT=
# DB_APP_DATA_USERNAME=
# DB_APP_DATA_PASSWORD=

# Sicherung (php artisan db:backup) bei MySQL/MariaDB: dump = mysqldump/mariadb-dump, php = in PHP (Webspaces ohne
# passendes mysqldump, z. B. Strato). Pfade der Programme bei Bedarf: PGSQL_DUMP_BINARY, MYSQL_DUMP_BINARY, MARIADB_DUMP_BINARY
# DB_BACKUP_METHOD=dump

# MariaDB: für SAFT selbst (DB_CONNECTION=mariadb) und/oder die MariaDB-Fassung der Forschungsdatenbank
# (external-demo:install --driver=mariadb) und deren Tests.
# (MariaDB im Container neben einem lokalen MySQL z. B. auf Port 3307.)
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_DATABASE=SAFT2
MARIADB_USERNAME=saft
MARIADB_PASSWORD=

# Optional: SQL Server für die SQL-Server-Fassung der Forschungsdatenbank (external-demo:install --driver=sqlsrv)
# und deren Tests. SAFT selbst läuft auf pgsql oder mysql.
MSSQL_HOST=127.0.0.1
MSSQL_PORT=1433
MSSQL_DATABASE=SAFT2_ext
MSSQL_USERNAME=saft
MSSQL_PASSWORD=

# Pfad zu pg_dump, mysqldump bzw. mariadb-dump für db:backup, falls nicht im PATH (MySQL als Snap: /snap/bin/mysql.mysqldump)
# PGSQL_DUMP_BINARY=
# MYSQL_DUMP_BINARY=
# MARIADB_DUMP_BINARY=

# DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME und DB_PASSWORD haben Vorrang vor beiden Blöcken
# (für Tests und bestehende Installationen); hier daher nicht setzen.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Produktion mit HTTPS: true (Sitzungs-Cookie nur über HTTPS)
# SESSION_SECURE_COOKIE=true
# HSTS (Browser nur noch über HTTPS, ein Jahr lang; nur bei Anfragen über HTTPS gesendet). Abschalten nur ausnahmsweise:
# SECURITY_HSTS=false
# Neue Passwörter mit bekannten Datenlecks abgleichen (Have I Been Pwned, nur ein Hash-Anfang verlässt den Server).
# Auf Servern ohne Internetzugang abschalten:
# PASSWORD_CHECK_LEAKED=false
# Pflicht zur Zwei-Faktor-Anmeldung (Einstellung unter Administration › Authentifizierung) aussetzen – nur für Tests:
# TWO_FACTOR_ENFORCE=false
# Geplante Aufgabe „Demo-Daten zurücksetzen“ erlauben (löscht die Daten der Demos und lädt sie neu) – nur für
# öffentliche Demo- und Schulungssysteme:
# DEMO_RESET=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# KI-Funktionen: Assistenten für Auswertungen und Tabellen, Hilfe-Assistent. Vorgabe: aus.
# Einschalten: Anbieter setzen, Zugangsdaten eintragen – den Schlüssel besser in den App-Einstellungen (dort
# verschlüsselt gespeichert) – und in den App-Einstellungen einschalten. Übertragen werden nie Datensätze.
# Siehe Systemadministration, Kapitel 5 „KI-Funktionen“ (config/ai.php).
# Anbieter: none | anthropic | bedrock | vertex
AI_PROVIDER=none
# Modell-ID; bei Amazon Bedrock mit Präfix, z. B. anthropic.claude-opus-5-5
# AI_MODEL=claude-opus-5-5
# Denktiefe: low | medium | high
# AI_EFFORT=medium
# Anfragen je Person und Tag, Obergrenze der Antwort, Sekunden je Anfrage (über max_execution_time von PHP halten)
# AI_DAILY_LIMIT=50
# AI_MAX_TOKENS=16000
# AI_TIMEOUT=120
# Anthropic direkt: Schlüssel (besser in den App-Einstellungen), Region der Verarbeitung, Proxy/Gateway
# ANTHROPIC_API_KEY=
# AI_INFERENCE_GEO=
# AI_BASE_URL=
# Amazon Bedrock: Region; Zugangsdaten aus AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY oder der Rolle der Instanz
# AI_AWS_REGION=
# Google Vertex AI: Projekt und Region; Anmeldung über Application Default Credentials (composer require google/auth)
# AI_VERTEX_PROJECT=
# AI_VERTEX_LOCATION=

# Initialer Super-Admin (DatabaseSeeder). Leeres Passwort = wird generiert.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Notausgang: lokalen Login erzwingen (übersteuert Einstellung in der DB)
AUTH_FORCE_LOCAL=false

# Vertrauenswürdige Proxys, wenn HTTPS vor dem Server endet (Load Balancer des Hosters):
# Adressen/Bereiche kommagetrennt, z. B. 10.0.0.0/8 – oder * nur, wenn der Server ausschließlich über den Proxy erreichbar ist.
# Leer: keinem Proxy vertrauen. Siehe config/trustedproxy.php.
TRUSTED_PROXIES=
