{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "saft/saft-xt",
    "type": "project",
    "description": "SAFT XT – metadata-driven database application framework (Laravel, Filament)",
    "keywords": ["database", "application-framework", "laravel", "filament"],
    "license": "PolyForm-Noncommercial-1.0.0",
    "repositories": [
        {
            "type": "path",
            "url": "plugins/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": "^8.4",
        "anourvalar/eloquent-serialize": "^1.3",
        "anthropic-ai/sdk": "^1.8",
        "bezhansalleh/filament-language-switch": "^5.1",
        "composer/semver": "^3.4",
        "filament/filament": "^5.11",
        "filament/spatie-laravel-settings-plugin": "^5.11",
        "laravel/framework": "^13.17",
        "laravel/socialite": "^5.31",
        "laravel/tinker": "^3.0",
        "mustache/mustache": "^3.2",
        "openspout/openspout": "^4.32",
        "phpoffice/phpword": "^1.4",
        "socialiteproviders/microsoft-azure": "^5.2",
        "socialiteproviders/saml2": "^4.12",
        "spatie/laravel-activitylog": "^5.1",
        "spatie/laravel-permission": "^8.5",
        "spatie/laravel-settings": "^3.10",
        "spatie/laravel-translatable": "^6.15",
        "sprain/swiss-qr-bill": "^5.5",
        "tecnickcom/tc-lib-pdf": "~8.85"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.15",
        "laravel-lang/common": "^6.8",
        "laravel/dusk": "^8.7",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^13.4.7",
        "reliese/laravel": "^1.4",
        "saft/ch-pruefungen": "^1.0",
        "saft/lager-tafel": "^1.0",
        "saft/lager-umbuchung": "^1.0",
        "saft/musikschule-planung": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "analyse": [
            "Composer\\Config::disableProcessTimeout",
            "vendor/bin/phpstan analyse --memory-limit=2G"
        ],
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "test:mysql": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi @no_additional_args",
            "vendor/bin/phpunit -c phpunit.mysql.xml"
        ],
        "test:mariadb": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi @no_additional_args",
            "vendor/bin/phpunit -c phpunit.mariadb.xml"
        ],
        "test:browser": [
            "Composer\\Config::disableProcessTimeout",
            "vendor/bin/phpunit -c phpunit.dusk.xml"
        ],
        "test:browser:mysql": [
            "Composer\\Config::disableProcessTimeout",
            "vendor/bin/phpunit -c phpunit.dusk.mysql.xml"
        ],
        "test:browser:mariadb": [
            "Composer\\Config::disableProcessTimeout",
            "vendor/bin/phpunit -c phpunit.dusk.mariadb.xml"
        ],
        "manual:screenshots": [
            "Composer\\Config::disableProcessTimeout",
            "vendor/bin/phpunit -c phpunit.dusk.xml --testsuite Manual"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.4.1"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
