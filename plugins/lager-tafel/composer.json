{
    "name": "saft/lager-tafel",
    "description": "Beispiel-Plugin für SAFT: Lagerspiegel, Lagertafel mit Drag and Drop, Kachel, Listener, Prüfregel (Lager-Demo)",
    "type": "library",
    "license": "PolyForm-Noncommercial-1.0.0",
    "version": "1.3.0",
    "require": {
        "php": "^8.4",
        "filament/filament": "^5.0",
        "saft/lager-umbuchung": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "Saft\\LagerTafel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Saft\\LagerTafel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Saft\\LagerTafel\\LagerTafelServiceProvider"
            ]
        },
        "saft": {
            "api": "^1.6"
        }
    }
}
