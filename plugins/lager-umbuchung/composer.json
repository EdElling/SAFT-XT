{
    "name": "saft/lager-umbuchung",
    "description": "Beispiel-Plugin für SAFT: Umbuchung zwischen Lagerorten (Lager-Demo)",
    "type": "library",
    "license": "PolyForm-Noncommercial-1.0.0",
    "version": "1.5.0",
    "require": {
        "php": "^8.4",
        "filament/filament": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Saft\\LagerUmbuchung\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Saft\\LagerUmbuchung\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Saft\\LagerUmbuchung\\LagerUmbuchungServiceProvider"
            ]
        },
        "saft": {
            "api": "^1.7"
        }
    }
}
