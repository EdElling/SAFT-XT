{
    "name": "saft/ch-pruefungen",
    "description": "Beispiel-Plugin für SAFT: Schweizer Prüfregeln (AHV-Nummer, IBAN, UID, Postleitzahl) und Rundung auf 5 Rappen",
    "type": "library",
    "license": "PolyForm-Noncommercial-1.0.0",
    "version": "1.1.0",
    "require": {
        "php": "^8.4",
        "filament/filament": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Saft\\ChPruefungen\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Saft\\ChPruefungen\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Saft\\ChPruefungen\\ChPruefungenServiceProvider"
            ]
        },
        "saft": {
            "api": "^1.6"
        }
    }
}
