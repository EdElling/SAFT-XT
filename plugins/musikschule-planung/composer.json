{
    "name": "saft/musikschule-planung",
    "description": "Beispiel-Plugin für SAFT: Stundenplan, Konfliktprüfung und Semester-Fortschreibung (Musikschul-Demo)",
    "type": "library",
    "license": "PolyForm-Noncommercial-1.0.0",
    "version": "1.1.0",
    "require": {
        "php": "^8.4",
        "filament/filament": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Saft\\MusikschulePlanung\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Saft\\MusikschulePlanung\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Saft\\MusikschulePlanung\\MusikschulePlanungServiceProvider"
            ]
        },
        "saft": {
            "api": "^1.9"
        }
    }
}
