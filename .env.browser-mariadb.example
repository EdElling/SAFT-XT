# Browser-Tests gegen MariaDB (composer test:browser:mariadb). Kopieren nach .env.browser-mariadb,
# Zugangsdaten eintragen und einen Schlüssel erzeugen: php artisan key:generate --env=browser-mariadb
# SAFT läuft auf MariaDB (Datenbanken SAFT2_dusk und SAFT2_dusk_app_data müssen vorhanden sein, der
# Login braucht dort alle Rechte);
# die externe Datenbank des Table-Connectors bleibt PostgreSQL (SAFT2_ext_dusk, PGSQL_*).
# Nur DB_CONNECTION und DB_DATABASE setzen: DB_HOST, DB_USERNAME … hätten Vorrang vor beiden Blöcken.
APP_NAME="SAFT XT"
APP_ENV=browser-mariadb
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8010
APP_TIMEZONE=Europe/Zurich
APP_LOCALE=de
APP_FALLBACK_LOCALE=de
BCRYPT_ROUNDS=4
LOG_CHANNEL=single

DB_CONNECTION=mariadb
DB_DATABASE=SAFT2_dusk

PGSQL_HOST=127.0.0.1
PGSQL_PORT=5432
PGSQL_USERNAME=saft
PGSQL_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=log
AUTH_FORCE_LOCAL=false

# Externe Datenbank für den Table-Connector (PostgreSQL, wird von Tests geleert)
EXT_DB_DATABASE=SAFT2_ext_dusk

# Optional: SQL Server als externe Quelle (Test DBC-09, wird übersprungen, wenn nicht erreichbar).
# Die Datenbank muss vorhanden sein; der Login braucht dort db_owner.
MSSQL_HOST=127.0.0.1
MSSQL_PORT=1433
MSSQL_USERNAME=saft
MSSQL_PASSWORD=
EXT_MSSQL_DB_DATABASE=SAFT2_ext_dusk

# MariaDB: Datenbank von SAFT und zugleich externe Quelle für Test DBC-10.
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3307
MARIADB_USERNAME=saft
MARIADB_PASSWORD=
EXT_MARIADB_DB_DATABASE=SAFT2_ext_dusk
