# Browser-Tests gegen MySQL (composer test:browser:mysql). Kopieren nach .env.browser-mysql,
# Zugangsdaten eintragen und einen Schlüssel erzeugen: php artisan key:generate --env=browser-mysql
# SAFT läuft auf MySQL (Datenbank SAFT2_dusk, Namensraum SAFT2_dusk_app_data legt SAFT selbst an);
# die externe Datenbank des Table-Connectors bleibt PostgreSQL (SAFT2_ext_dusk, PGSQL_*).
# Nur DB_CONNECTION und DB_DATABASE setzen: DB_HOST, DB_USERNAME … hätten Vorrang vor beiden Blöcken.
APP_NAME="SAFT XT"
APP_ENV=browser-mysql
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8010
APP_TIMEZONE=Europe/Zurich
APP_LOCALE=de
APP_FALLBACK_LOCALE=de
BCRYPT_ROUNDS=4
LOG_CHANNEL=single

DB_CONNECTION=mysql
DB_DATABASE=SAFT2_dusk
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USERNAME=saft
MYSQL_PASSWORD=

PGSQL_HOST=127.0.0.1
PGSQL_PORT=5432
PGSQL_USERNAME=saft
PGSQL_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=log
AUTH_FORCE_LOCAL=false

# Externe Datenbank für den Table-Connector (PostgreSQL, wird von Tests geleert)
EXT_DB_DATABASE=SAFT2_ext_dusk

# Optional: SQL Server als externe Quelle (Test DBC-09, wird übersprungen, wenn nicht erreichbar).
# Die Datenbank muss vorhanden sein; der Login braucht dort db_owner.
MSSQL_HOST=127.0.0.1
MSSQL_PORT=1433
MSSQL_USERNAME=saft
MSSQL_PASSWORD=
EXT_MSSQL_DB_DATABASE=SAFT2_ext_dusk

# Optional: MariaDB als externe Quelle (Test DBC-10, wird übersprungen, wenn nicht erreichbar).
# Die Datenbank muss vorhanden sein; der Login braucht dort alle Rechte.
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3307
MARIADB_USERNAME=saft
MARIADB_PASSWORD=
EXT_MARIADB_DB_DATABASE=SAFT2_ext_dusk

# Kein Abgleich mit Datenlecks (kein Internetzugriff in Tests)
PASSWORD_CHECK_LEAKED=false
# Pflicht zur Zwei-Faktor-Anmeldung aus (eigene Tests schalten sie ein)
TWO_FACTOR_ENFORCE=false
# KI-Funktionen aus: Browser-Tests sprechen nie einen Anbieter an
AI_PROVIDER=none
